{
  "name": "fetchcustom-vsm",
  "version": "3.0.1",
  "description": "Simple fetch custom",
  "main": "dist/index.js",
  "type": "module",
  "homepage": "https://github.com/Smejia11/FetchCustom",
  "bugs": {
    "url": "https://github.com/Smejia11/FetchCustom/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Smejia11/FetchCustom.git"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "check-format": "prettier --check \"{src,test}/**/*.{ts,tsx,js,jsx}\"",
    "ci": "pnpm run build && pnpm run check-format && pnpm run test",
    "prepublishOnly": "pnpm run ci",
    "format": "prettier --write \"{src,test}/**/*.{ts,tsx,js,jsx}\"",
    "format-all": "prettier --write .",
    "local-release": "changeset version && changeset publish"
  },
  "files": [
    "dist"
  ],
  "author": "Santiago Mejia",
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.16.2",
    "@changesets/cli": "^2.27.8",
    "prettier": "^3.6.2",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "@types/node": "^22.5.5"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "demo",
    "typescript"
  ]
}
